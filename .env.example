# Create a private .env file from this template.
# Never commit your real .env file to GitHub.

MANAGER_BOT_TOKEN=put_manager_bot_token_here
MP3_BOT_TOKEN=put_mp3_bot_token_here
MP4_BOT_TOKEN=put_mp4_bot_token_here

# Optional: absolute path to your own exported cookies file.
# Keep cookies private. Leave blank if not needed.
COOKIE_FILE=

# 0 means no configured playlist cap. Set e.g. 100 to cap playlists.
MAX_PLAYLIST_ITEMS=0

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
